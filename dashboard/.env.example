# ASVProject dashboard — environment
#
# With NO Supabase variables set, the app serves the bundled demo data under
# public/demo (baked by dashboard/tools/bake_demo.py). That mode is what CI
# and credential-less Vercel previews use.

# Supabase project (Settings -> API). Setting BOTH switches the app to the
# Supabase provider: catalogue from public.dash_clips, assets from the
# public `asvproject-clips` Storage bucket, audits into public.dash_audits.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — used by `pnpm ingest` (tools/ingest), never by the app.
SUPABASE_SERVICE_ROLE_KEY=

# Private R2 bucket for the full clip corpus (server-side only). When all
# four are set on the server AND NEXT_PUBLIC_ASSET_BASE=/api/assets, bundle
# assets are served through signed redirects instead of Supabase Storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=asvproject-clips
NEXT_PUBLIC_ASSET_BASE=

# Shared team password. When set, every page + /api/assets requires login
# (cookie). Unset = gate off (CI, local dev, public demo previews).
DASHBOARD_PASSWORD=
